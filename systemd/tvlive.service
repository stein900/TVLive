[Unit]
Description=TVLive — serveur télécommande
After=graphical-session.target network-online.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/stein/Documents/TVLive
ExecStart=/home/stein/Documents/TVLive/venv/bin/python /home/stein/Documents/TVLive/app.py
Restart=on-failure
RestartSec=5
Environment=HOME=/home/stein
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/stein/.Xauthority

[Install]
WantedBy=default.target
